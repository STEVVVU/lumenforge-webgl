{
  "name": "lumenforge-webgl",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Production-style WebGL2 glTF asset inspector with deferred PBR rendering and diagnostics",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest",
    "test:run": "vitest run",
    "browser:verify": "node scripts/verify-browser.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test:run && npm run build"
  },
  "dependencies": {
    "gl-matrix": "^3.4.4",
    "lucide-react": "^1.27.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@gltf-transform/core": "^4.4.2",
    "@playwright/test": "^1.62.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "playwright-core": "^1.49.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  }
}
