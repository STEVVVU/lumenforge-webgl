{
  "name": "lumenforge-webgl",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Production-style WebGL2 glTF asset inspector with deferred PBR rendering and diagnostics",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest",
    "test:run": "vitest run",
    "browser:verify": "node scripts/verify-browser.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test:run && npm run build"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "playwright-core": "^1.49.1",
    "typescript": "~5.6.3",
    "typescript-eslint": "^8.19.1",
    "vite": "^6.0.7",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  }
}
